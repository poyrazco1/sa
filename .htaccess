DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^$ index.php [L]
</IfModule>

# Config dosyalarına doğrudan web erişimini engelle (PHP parse edilmese bile
# kaynak/token sızmasın). Tüm config klasörü + hassas uzantılar kapalı.
<FilesMatch "^(app|db|tsoft|secrets\.local)\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(sql|md|txt|log|ini|env|bak|backup|v[0-9]+backup)$">
  Require all denied
</FilesMatch>

# /config klasörünün tamamını kapat (Apache 2.4)
RedirectMatch 403 ^/config/.*$
